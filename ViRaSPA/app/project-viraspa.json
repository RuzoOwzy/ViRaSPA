    "outputFolder": "bundled",
    "framework": true,
    "app": true,
    "pack": true,
    "compact": true,
    "preload": true
  },
  "deploy": {
    "targets": [
      {
        "name": "local-staging",
        "destination": "releases/staging",
        "serverType": "iis",
        "environment": "staging",
        "keepPrevious": 2
      },
      {
        "name": "local-production",
        "destination": "releases/production",
        "serverType": "apache",
        "environment": "production",
        "keepPrevious": 2
      }
    ],
    "environments": [
      {
        "name": "staging",
        "settings": {
          "apiBaseAddress": "https://jsonplaceholder.typicode.com"
        }
      },
      {
        "name": "production",
        "settings": {
          "apiBaseAddress": "https://jsonplaceholder.typicode.com"
