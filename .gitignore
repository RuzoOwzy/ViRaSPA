# Dependencies and build output
node_modules/
dist/

# Environment files (may hold secrets)
.env
.env.*

# Logs and caches
*.log
npm-debug.log*
coverage/
.cache/

# Temporary and editor swap files
*.tmp
*.swp
*~

# Editors and IDEs (jsconfig.json is tracked on purpose)
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ViRaSPA generated output: prerendered pages (created only by
# node-tools/prerender.js) and the release stamp written at deploy time
ViRaSPA/prerendered/
ViRaSPA/release.json

# Releases written by node-tools/deploy.js (sample targets in project-viraspa.json)
releases/

# Libraries are pinned in ViRaSPA/app/project-viraspa.json and restored with
#   node node-tools/install.js restore
# (official components in ViRaSPA/components/ stay tracked until the
# ViRaSPA-Components repository is published)
ViRaSPA/lib/

# Leftovers of an interrupted install.js run
*.installing/
*.previous/

# Claude Code per-user local settings
.claude/settings.local.json
